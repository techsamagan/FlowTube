# ── Mode ─────────────────────────────────────────────────────────────
# This file is the LOCAL DEV template. NEVER put production secrets in
# .env on disk — put them in the Render dashboard for the backend and the
# Vercel dashboard for the frontend. If a real key has ever been on disk
# locally, rotate it now (Anthropic/Google/Kling/etc. all have rotate
# buttons in their consoles).
#
# true  = no external API calls, realistic mock data (default)
# false = use the real keys below
MOCK_MODE=true

PORT=4000

# ── Database (Supabase) ──────────────────────────────────────────────
# Use a SEPARATE Supabase project for local dev — don't point your
# laptop at the production DB. Supabase → Project Settings → Database:
#   DATABASE_URL = "Transaction pooler" URI (host ...pooler..., port 6543)
#                  append ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Direct connection" URI (port 5432) — used for migrations
DATABASE_URL=
DIRECT_URL=

# ── Redis (per-channel render lock) ──────────────────────────────────
# Required to run more than one backend instance; optional otherwise
# (falls back to an in-memory lock that's per-process only).
REDIS_URL=redis://localhost:6379

# ── Google OAuth (YouTube) ───────────────────────────────────────────
# Fill these to make "+ Connect Google account" pull REAL channels.
# Works even with MOCK_MODE=true (AI stays mocked, channels are real).
# Google Cloud → APIs&Services: enable "YouTube Data API v3",
#   create OAuth client (type: Web application),
#   Authorized redirect URI = the GOOGLE_REDIRECT_URI below,
#   add your Google address as a Test user on the OAuth consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Encrypts Google refresh tokens at rest (AES-256-GCM). Use any long random
# string in production; falls back to NEXTAUTH_SECRET if unset.
TOKEN_ENC_KEY=

# ── AI / Media ───────────────────────────────────────────────────────
# ANTHROPIC_API_KEY: real Claude scripts/metadata/recommendations.
#   Requires MOCK_MODE=false to take effect.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
# YOUTUBE_API_KEY: real trend/competitor search (Google Cloud → API key,
#   YouTube Data API v3 enabled). Works independently of OAuth & MOCK_MODE.
YOUTUBE_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
# PIXABAY_API_KEY: royalty-free background music (Pixabay license — safe for
#   monetized YouTube, no attribution, NOT Content-ID flagged). No key →
#   videos render with NO music (never copyrighted/trending audio).
PIXABAY_API_KEY=

# ── Storage (S3 / Cloudflare R2) ─────────────────────────────────────
# When set, rendered MP4s persist to the bucket and YouTube uploads stream
# back from there — surviving Render container restarts. Leave blank to
# keep MP4s on the ephemeral container disk (dev / first-pass deploys).
# For Cloudflare R2: set AWS_ENDPOINT_URL to your R2 endpoint
# (e.g. https://<account>.r2.cloudflarestorage.com) and AWS_REGION=auto.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=

# ── Render-pipeline plumbing ─────────────────────────────────────────
# Public origin of THIS backend, used to build the media URL and the
# video-provider webhook callback URL. On Render the platform sets
# RENDER_EXTERNAL_URL automatically — this can stay blank in that case.
PUBLIC_BACKEND_URL=
# Shared secret providers send back in X-Webhook-Secret. Without this,
# webhooks are disabled (polling still works). Generate with
# `openssl rand -hex 32`.
WEBHOOK_SECRET=

# ── App auth (NextAuth.js) ───────────────────────────────────────────
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000
